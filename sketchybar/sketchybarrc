#!/usr/bin/env bash
# Starter SketchyBar config for AeroSpace
# Put this file at: ~/.config/sketchybar/sketchybarrc

PLUGIN_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}/plugins"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

# Bar look
sketchybar --bar \
    height=32 \
    position=top \
    sticky=on \
    padding_left=8 \
    padding_right=8 \
    color=0xee1e1e2e

# Default item style
sketchybar --default \
    icon.font="Hack Nerd Font:Bold:14.0" \
    icon.color=0xffffffff \
    label.font="Hack Nerd Font:Bold:13.0" \
    label.color=0xffffffff \
    padding_left=6 \
    padding_right=6

# AeroSpace workspaces (left)
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_ready
sketchybar --add event aerospace_mode_change

# The shared preset has seven persistent workspaces. Build their buttons even
# when the Homebrew service starts before AeroSpace at login.
for sid in 1 2 3 4 5 6 7; do
    sketchybar --add item space.$sid left \
        --set space.$sid \
            background.color=0xff89b4fa \
            background.corner_radius=6 \
            background.height=18 \
            background.drawing=off \
            label="$sid" \
            label.padding_left=8 \
            label.padding_right=8 \
            click_script="aerospace workspace $sid"
done

# One state query updates every workspace and displays non-main binding modes.
# Polling also repairs a missed startup event or an AeroSpace restart.
sketchybar --add item aerospace_status left \
    --set aerospace_status \
        icon.drawing=off \
        label.color=0xfff9e2af \
        label="Waiting for AeroSpace" \
        update_freq=5 \
        script="\"$PLUGIN_DIR/aerospace.sh\"" \
    --subscribe aerospace_status aerospace_workspace_change aerospace_ready aerospace_mode_change system_woke

# Front app name
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off \
        script="\"$PLUGIN_DIR/front_app.sh\"" \
    --subscribe front_app front_app_switched

# Right side. First item added sits furthest right: clock, battery, volume, wifi.
sketchybar --add item clock right \
    --set clock \
        update_freq=10 \
        script="\"$PLUGIN_DIR/clock.sh\""

sketchybar --add item battery right \
    --set battery \
        update_freq=30 \
        script="\"$PLUGIN_DIR/battery.sh\"" \
    --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
    --set volume \
        script="\"$PLUGIN_DIR/volume.sh\"" \
    --subscribe volume volume_change

sketchybar --add item wifi right \
    --set wifi \
        update_freq=30 \
        script="\"$PLUGIN_DIR/wifi.sh\"" \
    --subscribe wifi wifi_change system_woke

sketchybar --update
